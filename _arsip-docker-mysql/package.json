{
  "name": "bilderlabs-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Outreach CRM for Bilder Labs: leads, follow-up schedule, email sequences and results.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/cli.js migrate",
    "seed": "node --env-file-if-exists=.env src/cli.js seed data/seed.json",
    "user:add": "node --env-file-if-exists=.env src/cli.js user:add",
    "user:password": "node --env-file-if-exists=.env src/cli.js user:password",
    "user:list": "node --env-file-if-exists=.env src/cli.js user:list"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "mysql2": "^3.24.5"
  }
}
