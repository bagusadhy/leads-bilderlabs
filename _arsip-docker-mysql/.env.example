# Salin jadi .env lalu isi. File .env jangan di-commit ke git.

# ---------- Aplikasi ----------
# Port di VPS untuk dashboard
APP_PORT=3000
# 127.0.0.1 = hanya bisa diakses dari VPS (pakai reverse proxy/Tailscale/SSH tunnel)
# 0.0.0.0   = terbuka di jaringan
APP_BIND=127.0.0.1
# true kalau dashboard dibuka lewat HTTPS
COOKIE_SECURE=false
# true kalau di belakang Nginx, Caddy, Traefik atau Cloudflare Tunnel
TRUST_PROXY=false
# Lama login tersimpan (hari)
SESSION_DAYS=30
# Opsional: token untuk import otomatis (n8n/skrip). Buat dengan: openssl rand -hex 32
API_TOKEN=

# ---------- MySQL yang sudah ada ----------
# Nama network Docker tempat container MySQL berada
DB_NETWORK=mysql_default
# Nama container MySQL di network itu (atau host.docker.internal kalau port MySQL dibuka di host)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=bilder_dashboard
DB_USER=bilder
DB_PASSWORD=ganti-dengan-password-yang-kuat
